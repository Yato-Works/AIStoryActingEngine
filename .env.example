# AIStoryActingEngine 環境設定ファイル
# 本ファイルを .env にコピーして各項目を設定してください。

# 1. 台本家 (Script Writer) 設定
# Gemini API キーを設定すると、自動的に GeminiScriptWriter（文脈読解＋平仮名化＋45種演技絵文字演出）が有効になります。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 台本家の強制指定（gemini / openjtalk / llm / dictionary）
# READING_WRITER=gemini

# 2. TTS Backend (Irodori-TTS) 設定
IRODORI_HOST=http://127.0.0.1:8088
# IRODORI_VOICES_DIR=C:\Users\smily\Irodori-TTS-Server\voices
